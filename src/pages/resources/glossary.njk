---
permalink: /resources/glossary/
title: "Export & Trade Finance Glossary"
description: "60+ export, shipping and trade-finance terms explained in plain language, from APEDA to transshipment."
lang: en
dir: ltr
breadcrumbs: [{ label: "Resources", url: "/resources/" }, { label: "Glossary" }]
---
{% extends "layouts/base.njk" %}
{% block content %}
{% set pageH1 = "Export Glossary" %}
{% set pageLede = "Common terms in international trade, shipping and export documentation." %}
{% include "partials/page-header.njk" %}

<section class="section">
  <div class="container" style="max-width:76ch">
    <dl style="display:flex;flex-direction:column;gap:1.2em">
      {% for item in glossary | sort(attribute="term") %}
      <div id="{{ item.term | slugify }}" style="scroll-margin-top:100px;border-bottom:1px solid var(--color-border);padding-block-end:1em">
        <dt style="font-weight:700;font-family:var(--font-serif);font-size:var(--fs-md)"><a href="#{{ item.term | slugify }}" style="color:inherit">{{ item.term }}</a></dt>
        <dd style="margin:0;margin-block-start:0.3em;color:var(--color-ink-muted)">{{ item.def }}</dd>
      </div>
      {% endfor %}
    </dl>
  </div>
</section>

<script type="application/ld+json">
{{ glossary | definedTermSetSchema(site.url) | safe }}
</script>

{% include "partials/cta-rfq-section.njk" %}
{% endblock %}
