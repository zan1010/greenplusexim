---
permalink: /styleguide/
title: "Style Guide"
description: "Internal component reference — not indexed."
lang: en
dir: ltr
noindex: true
---
{% extends "layouts/base.njk" %}
{% block content %}
<div class="dev-banner">Internal style guide — noindex</div>
<div class="container section">
  <h1>Green Plus EXIM — Style Guide</h1>
  <p class="lede">Component reference for design consistency across 150+ pages.</p>

  <h2>Colour</h2>
  <div class="grid grid--4">
    <div class="card"><div class="card-body" style="background:var(--color-forest);color:#fff">Forest #0F3D2E</div></div>
    <div class="card"><div class="card-body" style="background:var(--color-leaf);color:#fff">Leaf #2E7D4F</div></div>
    <div class="card"><div class="card-body" style="background:var(--color-gold);color:var(--color-ink)">Gold #C9A227</div></div>
    <div class="card"><div class="card-body" style="background:var(--color-sage)">Sage #E6EDE8</div></div>
  </div>

  <h2>Typography</h2>
  <h1>Heading 1 / Fraunces</h1>
  <h2>Heading 2 / Fraunces</h2>
  <h3>Heading 3 / Fraunces</h3>
  <p>Body text in Inter. The quick brown fox jumps over the lazy dog. 0123456789.</p>

  <h2>Buttons</h2>
  <div class="cluster">
    <a class="btn btn-primary" href="#">Primary</a>
    <a class="btn btn-secondary" href="#">Secondary</a>
    <a class="btn btn-whatsapp" href="#">WhatsApp</a>
  </div>

  <h2>Cards</h2>
  <div class="grid grid--3">
    {% for cat in productCategories | limit(3) %}
    <div class="card">
      <div class="card-body">
        <div class="chip-row"><span class="chip">HS 0000</span><span class="chip chip--gold">Featured</span></div>
        <h3>{{ cat.label }}</h3>
        <p style="font-size:var(--fs-sm)">{{ cat.blurb }}</p>
        <span class="markets-row">Key markets: UAE, Saudi Arabia, Netherlands</span>
      </div>
    </div>
    {% endfor %}
  </div>

  <h2>Data table</h2>
  <div class="table-wrap">
    <table class="data-table">
      <thead><tr><th scope="col">Country</th><th scope="col">Value (USD)</th><th scope="col">Share</th></tr></thead>
      <tbody>
        <tr><td>UAE</td><td>1,000,000</td><td>22%</td></tr>
        <tr><td>Saudi Arabia</td><td>800,000</td><td>18%</td></tr>
      </tbody>
    </table>
  </div>

  <h2>FAQ accordion</h2>
  {% set faqId = "sg" %}
  {% set faqs = [{q: "Sample question?", a: "Sample answer text."}] %}
  {% include "partials/faq.njk" %}

  <h2>RFQ form (step 1 of 2)</h2>
  {% set formId = "styleguide" %}
  {% include "partials/rfq-form.njk" %}

  <h2>Quick-quote form</h2>
  {% set formId = "sg-qq" %}
  {% include "partials/quick-quote-form.njk" %}

  <h2>CTA band</h2>
  {% include "partials/cta-band.njk" %}

  <h2>Trade routes map</h2>
  {% include "partials/trade-routes-map.njk" %}
</div>
{% endblock %}
