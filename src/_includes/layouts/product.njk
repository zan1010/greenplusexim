{% extends "layouts/base.njk" %}

{% block schema %}
<script type="application/ld+json">
{{ {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": (productName + " from India"),
  "description": description,
  "image": (productImage or placeholderImages['hero-port'].url),
  "category": category,
  "brand": { "@type": "Organization", "name": site.companyName, "@id": (site.url + "/#organization") },
  "additionalProperty": ([{ "@type": "PropertyValue", "name": "HS Code", "value": hsCode }] + (specs | default([]) | schemaProps))
} | jsonify | safe }}
</script>
{% endblock %}

{% block content %}
{% set pageH1 = productName + " Exporter from India" %}
{% set pageLede = tagline %}
{% include "partials/page-header.njk" %}

<section class="section">
  <div class="container">
    <div class="grid grid--2" style="gap:var(--sp-5);align-items:start">
      <div class="prose">
        <div class="tldr-box">
          <p><strong>Quick answer:</strong> {{ quickAnswer }}</p>
        </div>

        <div class="chip-row" style="margin-block:var(--sp-2)">
          <span class="chip chip--gold">HS {{ hsCode }}</span>
          <span class="chip">{{ category }}</span>
          {% if keyMarkets %}<span class="chip">Key markets: {{ keyMarkets }}</span>{% endif %}
        </div>

        {{ content | safe }}
      </div>

      <div>
        {% set formId = "product" %}
        {% set prefillProduct = productName %}
        {% set ctaHeadline = "Get a quote for " + productName %}
        {% include "partials/rfq-form.njk" %}
      </div>
    </div>
  </div>
</section>

{% if specs %}
<section class="section section--sage">
  <div class="container" style="max-width:76ch">
    <h2>{{ productName }} specifications</h2>
    <div class="table-wrap">
      <table class="data-table">
        <thead><tr><th scope="col">Parameter</th><th scope="col">Typical specification</th></tr></thead>
        <tbody>
          {% for spec in specs %}
          <tr><td>{{ spec.name }}</td><td>{{ spec.value }}</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    <p style="font-size:var(--fs-sm);color:var(--color-ink-muted)">Typical specs — final specifications as per contract. Tell us your required grade when you request a quote and we'll confirm availability.</p>
  </div>
</section>
{% endif %}

<section class="section">
  <div class="container" style="max-width:76ch">
    <h2>Packaging &amp; container loading</h2>
    <div class="table-wrap">
      <table class="data-table">
        <thead><tr><th scope="col">Detail</th><th scope="col">Options</th></tr></thead>
        <tbody>
          <tr><td>Packaging</td><td>{{ packaging }}</td></tr>
          <tr><td>Minimum order quantity</td><td>{{ moq | default(site.defaultMoq) }}</td></tr>
          <tr><td>Loading capacity (20ft)</td><td>{{ loading20 }}</td></tr>
          {% if loading40 %}<tr><td>Loading capacity (40ft)</td><td>{{ loading40 }}</td></tr>{% endif %}
          {% if shelfLife %}<tr><td>Shelf life &amp; storage</td><td>{{ shelfLife }}</td></tr>{% endif %}
        </tbody>
      </table>
    </div>
    <p style="font-size:var(--fs-sm);color:var(--color-ink-muted)">Loading figures are typical estimates — use our <a href="/resources/container-loading-calculator/">container loading calculator</a> for a planning estimate, and confirm exact figures with us before booking.</p>
    <p><a href="/spec-sheets/{{ productName | slugify }}.pdf">Download {{ productName }} specification sheet (PDF)</a></p>
  </div>
</section>

{% if availability %}
<section class="section section--sage">
  <div class="container" style="max-width:76ch">
    <h2>Availability calendar</h2>
    <p>Typical availability for {{ productName | lower }} from India, by month:</p>
    {% set monthLabels = ["J","F","M","A","M","J","J","A","S","O","N","D"] %}
    <div class="table-wrap">
      <table class="data-table">
        <thead><tr>{% for m in monthLabels %}<th scope="col">{{ m }}</th>{% endfor %}</tr></thead>
        <tbody>
          <tr>
            {% for i in range(1, 13) %}
            <td style="text-align:center;{% if i in availability %}background:rgba(46,125,79,0.15){% endif %}">{% if i in availability %}●{% endif %}</td>
            {% endfor %}
          </tr>
        </tbody>
      </table>
    </div>
    <p style="font-size:var(--fs-sm);color:var(--color-ink-muted)">Availability shifts year to year with weather and growing conditions — ask for current availability before planning a shipment window.</p>
  </div>
</section>
{% endif %}

{% if tradeData %}
{% set td = tradeDataFiles[tradeData] %}
<section class="section">
  <div class="container" style="max-width:76ch">
    {% include "partials/trade-data-table.njk" %}
  </div>
</section>
{% endif %}

{% if sourcingRegions %}
<section class="section section--sage">
  <div class="container" style="max-width:76ch">
    <h2>Indian sourcing regions</h2>
    <p>{{ sourcingRegions }}</p>
  </div>
</section>
{% endif %}

<section class="section">
  <div class="container" style="max-width:76ch">
    <h2>Export documentation</h2>
    <p>{{ site.complianceStatement }}</p>
    {% if documentation %}
    <ul style="display:flex;flex-direction:column;gap:0.5em;margin-block:var(--sp-2);padding-inline-start:1.4em;list-style:disc">
      {% for doc in documentation %}<li>{{ doc }}</li>{% endfor %}
    </ul>
    {% endif %}
    <p>{{ site.complianceChecklistCta }} {{ site.inspectionStatement }}</p>
  </div>
</section>

{% include "partials/cta-band.njk" %}

{% if faqs %}
<section class="section">
  <div class="container" style="max-width:76ch">
    <h2>{{ productName }} export FAQs</h2>
    {% set faqId = "product" %}
    {% include "partials/faq.njk" %}
  </div>
</section>
{% endif %}

{% if relatedProducts or relatedPosts %}
<section class="section section--sage">
  <div class="container">
    {% if relatedProducts %}
    <h2>Related products</h2>
    <div class="grid grid--3" style="margin-block-end:var(--sp-4)">
      {% for rel in relatedProducts %}
      <a class="card" href="{{ rel.url }}"><div class="card-body"><h3>{{ rel.label }}</h3></div></a>
      {% endfor %}
    </div>
    {% endif %}
    {% if relatedPosts %}
    <h2>Related guides</h2>
    <div class="grid grid--3">
      {% for post in relatedPosts %}
      <a class="card" href="{{ post.url }}"><div class="card-body"><h3>{{ post.label }}</h3></div></a>
      {% endfor %}
    </div>
    {% endif %}
  </div>
</section>
{% endif %}

{% set ctaHeadline = "Request a quote for " + productName %}
{% set ctaSubtext = "Tell us your quantity, destination port and required specification — we'll come back within 24 business hours." %}
{% set prefillProduct = productName %}
{% set formId = "product-bottom" %}
{% include "partials/cta-rfq-section.njk" %}
{% endblock %}
