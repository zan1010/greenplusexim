<div class="trade-map reveal" role="img" aria-label="Diagram of Green Plus EXIM's export trade lanes from India to the Middle East &amp; GCC, South Asia, Southeast Asia, East Asia, Europe, Africa, North America and Latin America">
  <svg viewBox="0 0 800 480" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto">
    <defs>
      <marker id="routeArrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto">
        <path d="M0,0 L10,5 L0,10 z" fill="#C9A227"/>
      </marker>
    </defs>

    <!-- Radar-style rings centred on India, purely decorative grounding so the nodes don't float in empty space -->
    <g stroke="#0F3D2E" stroke-width="1" fill="none" opacity="0.08">
      <circle cx="400" cy="240" r="62"/>
      <circle cx="400" cy="240" r="124"/>
      <circle cx="400" cy="240" r="185"/>
    </g>

    <!-- Straight spokes, evenly spaced at 45°: unlike curves, straight lines from a single
         centre point can never cross each other, so this can't produce the tangled look the
         earlier bezier-curve version did when two destinations sat close together on the same side. -->
    <g stroke="#C9A227" stroke-width="1.5" fill="none" opacity="0.75">
      <line class="route" x1="400" y1="240" x2="400" y2="61" stroke-dasharray="6 6" marker-end="url(#routeArrow)"/>
      <line class="route" x1="400" y1="240" x2="524" y2="115" stroke-dasharray="6 6" marker-end="url(#routeArrow)"/>
      <line class="route" x1="400" y1="240" x2="579" y2="240" stroke-dasharray="6 6" marker-end="url(#routeArrow)"/>
      <line class="route" x1="400" y1="240" x2="524" y2="365" stroke-dasharray="6 6" marker-end="url(#routeArrow)"/>
      <line class="route" x1="400" y1="240" x2="400" y2="419" stroke-dasharray="6 6" marker-end="url(#routeArrow)"/>
      <line class="route" x1="400" y1="240" x2="276" y2="365" stroke-dasharray="6 6" marker-end="url(#routeArrow)"/>
      <line class="route" x1="400" y1="240" x2="221" y2="240" stroke-dasharray="6 6" marker-end="url(#routeArrow)"/>
      <line class="route" x1="400" y1="240" x2="276" y2="115" stroke-dasharray="6 6" marker-end="url(#routeArrow)"/>
    </g>

    <g fill="#0F3D2E">
      <circle cx="400" cy="61" r="5"/>
      <circle cx="524" cy="115" r="5"/>
      <circle cx="579" cy="240" r="5"/>
      <circle cx="524" cy="365" r="5"/>
      <circle cx="400" cy="419" r="5"/>
      <circle cx="276" cy="365" r="5"/>
      <circle cx="221" cy="240" r="5"/>
      <circle cx="276" cy="115" r="5"/>
    </g>

    <!-- India hub, drawn last so it sits on top of every route line -->
    <circle cx="400" cy="240" r="11" fill="#0F3D2E"/>
    <circle cx="400" cy="240" r="16" fill="none" stroke="#0F3D2E" stroke-width="1.5" opacity="0.35"/>

    <g font-family="Inter, sans-serif" font-size="14" fill="#14201B" font-weight="600">
      <text x="400" y="43" text-anchor="middle">Europe</text>
      <text x="536" y="103" text-anchor="start">Middle East &amp; GCC</text>
      <text x="591" y="245" text-anchor="start">East Asia</text>
      <text x="536" y="390" text-anchor="start">Southeast Asia</text>
      <text x="400" y="443" text-anchor="middle">South Asia</text>
      <text x="264" y="390" text-anchor="end">Latin America</text>
      <text x="209" y="245" text-anchor="end">Africa</text>
      <text x="264" y="103" text-anchor="end">North America</text>
      <text x="400" y="274" text-anchor="middle" font-size="15" font-weight="700">India</text>
    </g>
  </svg>
</div>
