<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/">
      <svg aria-hidden="true"><use href="/assets/icons.svg#icon-leaf"></use></svg>
      <span>Green Plus EXIM</span>
    </a>

    <nav class="primary-nav" aria-label="Primary">
      <ul>
        {% for item in nav.primary %}
        <li class="nav-item">
          {% if item.megaMenu %}
          <a class="nav-link" href="{{ item.url }}" aria-haspopup="true" aria-expanded="false">
            {{ item.label }}
            <svg width="14" height="14" aria-hidden="true"><use href="/assets/icons.svg#icon-chevron-down"></use></svg>
          </a>
          <div class="mega-menu">
            {% for col in item.columns %}
            <div class="mega-col">
              <h4>{{ col.heading }}</h4>
              {% for link in col.items %}
              <a href="{{ link.url }}">{{ link.label }}</a>
              {% endfor %}
            </div>
            {% endfor %}
          </div>
          {% elif item.children %}
          <a class="nav-link" href="{{ item.url }}" aria-haspopup="true" aria-expanded="false">
            {{ item.label }}
            <svg width="14" height="14" aria-hidden="true"><use href="/assets/icons.svg#icon-chevron-down"></use></svg>
          </a>
          <div class="dropdown">
            {% for link in item.children %}
            <a href="{{ link.url }}">{{ link.label }}</a>
            {% endfor %}
          </div>
          {% else %}
          <a class="nav-link" href="{{ item.url }}">{{ item.label }}</a>
          {% endif %}
        </li>
        {% endfor %}
      </ul>
    </nav>

    <div class="header-actions">
      <a class="btn btn-secondary" href="tel:{{ site.phoneE164 }}">
        <svg width="16" height="16" aria-hidden="true"><use href="/assets/icons.svg#icon-phone"></use></svg>
        Call
      </a>
      <a class="btn btn-primary" href="/get-a-quote/" data-quote-cta="header">Get Export Quote</a>
      <button type="button" class="hamburger" aria-expanded="false" aria-controls="mobile-drawer" aria-label="Open menu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<div class="mobile-drawer" id="mobile-drawer" hidden>
  <div class="mobile-drawer-header">
    <a class="brand" href="/">
      <svg aria-hidden="true"><use href="/assets/icons.svg#icon-leaf"></use></svg>
      <span>Green Plus EXIM</span>
    </a>
    <button type="button" class="hamburger mobile-drawer-close" aria-label="Close menu">
      <svg width="22" height="22" aria-hidden="true"><use href="/assets/icons.svg#icon-close"></use></svg>
    </button>
  </div>

  <div class="mobile-accordion">
    {% for item in nav.primary %}
      {% if item.megaMenu or item.children %}
      <div>
        <button type="button" aria-expanded="false" aria-controls="drawer-panel-{{ loop.index }}">
          {{ item.label }}
          <svg class="chevron" width="16" height="16" aria-hidden="true"><use href="/assets/icons.svg#icon-chevron-down"></use></svg>
        </button>
        <div class="mobile-accordion-panel" id="drawer-panel-{{ loop.index }}">
          {% if item.megaMenu %}
            {% for col in item.columns %}{% for link in col.items %}
            <a href="{{ link.url }}">{{ link.label }}</a>
            {% endfor %}{% endfor %}
          {% else %}
            {% for link in item.children %}
            <a href="{{ link.url }}">{{ link.label }}</a>
            {% endfor %}
          {% endif %}
        </div>
      </div>
      {% else %}
      <div>
        <a href="{{ item.url }}" style="display:block;padding:0.8em 0;font-weight:600;font-family:var(--font-serif);font-size:var(--fs-md);border-bottom:1px solid var(--color-border)">{{ item.label }}</a>
      </div>
      {% endif %}
    {% endfor %}
  </div>

  <div class="mobile-drawer-cta">
    <a class="btn btn-primary btn-block" href="/get-a-quote/" data-quote-cta="mobile-drawer">Get Export Quote</a>
    <a class="btn btn-whatsapp btn-block" href="#" data-whatsapp>
      <svg width="18" height="18" aria-hidden="true"><use href="/assets/icons.svg#icon-whatsapp"></use></svg>
      WhatsApp Us
    </a>
  </div>
</div>
